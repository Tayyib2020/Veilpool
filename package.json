{
  "name": "veilpool-phase-1",
  "version": "0.1.0",
  "private": true,
  "description": "VeilPool Phase 1 confidential-token foundation",
  "engines": {
    "node": ">=20",
    "npm": ">=7"
  },
  "scripts": {
    "clean": "rimraf ./artifacts ./cache ./types ./coverage",
    "compile": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat compile",
    "postcompile": "npm run typechain",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy-sepolia.ts --network sepolia",
    "build:ts": "tsc --project tsconfig.json",
    "typechain": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat typechain"
  },
  "dependencies": {
    "@fhevm/mock-utils": "0.4.2",
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "5.6.1",
    "encrypted-types": "0.0.4"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.30",
    "chai": "4.5.0",
    "chai-as-promised": "8.0.2",
    "cross-env": "7.0.3",
    "hardhat": "2.28.6",
    "mocha": "11.7.5",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "elliptic": ">=6.6.1",
    "micromatch": ">=4.0.8",
    "minimatch": "^3.1.2",
    "undici": ">=6.21.1 <7.0.0",
    "ws": ">=7.5.10"
  }
}
